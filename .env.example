# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# Public URL of the site (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Google Sheet (data store) ─────────────────────────────────────────
# From the Sheet URL: https://docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEET_ID=
# From the service account JSON key: client_email
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# From the service account JSON key: private_key (keep the \n sequences, wrap in quotes)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Optional: comma-separated Google accounts allowed to edit the protected Receipts tab
SHEET_OWNER_EMAILS=

# ── Email (SMTP) ──────────────────────────────────────────────────────
# Gmail: smtp.gmail.com / 465, with an app password (needs 2-Step Verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Must be the same address as SMTP_USER when using Gmail
MAIL_FROM="Jeevansphere Foundation <your-address@gmail.com>"
# Who receives form alerts and donation notifications (comma-separated)
ADMIN_EMAILS=
# Link included in team emails so staff can jump to the Sheet
NEXT_PUBLIC_SHEET_URL=

# ── Spam protection (optional, free) ──────────────────────────────────
# Cloudflare Turnstile. Leave empty to skip the check.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Automation secrets (random strings, e.g. `openssl rand -hex 32`) ──
# Vercel sends this to /api/cron/daily
CRON_SECRET=
# The Google Apps Script in the Sheet sends this to /api/admin/receipts
ADMIN_API_KEY=
